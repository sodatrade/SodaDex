{
  "name": "@sodadex/test-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:unified": "node ../../scripts/sodadex/build-unified-web.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && web/node_modules/.bin/oxlint --config web/.oxlintrc.json --deny-warnings web/src web/tests web/tooling web/vite.config.ts web/vitest.config.ts trading-policy.ts v2-protocol.ts network-profile.ts mining-contracts.ts mining-products.ts mining-abi.ts mining-calls.ts mining-signed-calls.ts mining-discovery.ts mining-math.ts mining-market.ts",
    "build:mining-test": "VITE_SODADEX_NETWORK_PROFILE=1952-mining-test vite build --outDir dist-mining-1952",
    "build:dex-test": "node ../../scripts/sodadex/build-dex-test-web.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.20",
    "@uniswap/sdk-core": "7.19.4",
    "@uniswap/v3-sdk": "3.31.0",
    "@uniswap/v4-sdk": "2.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.3.1",
    "viem": "2.49.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "oxlint": "1.73.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
