{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "svelte"],
    "baseUrl": ".",
    "paths": { "$lib": ["src/lib"], "$lib/*": ["src/lib/*"] }
  },
  "include": ["src", "tests", "tooling", "vite.config.ts", "vitest.config.ts"]
}
