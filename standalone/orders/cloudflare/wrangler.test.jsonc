{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "sodadex-orders-test",
  "main": "index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "SodaOrders" }] },
