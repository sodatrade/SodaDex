{
  "name": "@sodadex/orders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node --experimental-sqlite --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "test:integration": "node --experimental-sqlite --experimental-strip-types test/integration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "viem": "2.49.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "oxlint": "1.73.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vite": "8.1.3"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.0"
    }
  }
}
