{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "sodadex-mining-api-test-196",
  "main": "index.ts",
  "tsconfig": "../tsconfig.json",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MINING_196",
        "class_name": "SodaMining196Test"
      }
    ]
  },
  "migrations": [
    {
      "tag": "sodadex-mining-196-test-v1",
      "new_sqlite_classes": [
        "SodaMining196Test"
      ]
    }
  ],
  "vars": {
    "MINING_NETWORK_PROFILE": "196-mining-test",
    "MINING_SERVICE_RETIRED": "true",
    "MINING_PUBLIC_ORIGIN": "https://sodadex-mining-test-196.invalid",
    "MINING_ADMISSION_ENABLED": "false",
    "MINING_EXECUTION_ENABLED": "false",
    "MINING_GAS_CAP_WEI": "0",
    "MINING_MAX_GAS_PER_TRANSACTION": "0",
    "MINING_MAX_GAS_PRICE_WEI": "0",
    "MINING_OPERATING_POLICY": "policy_pending"
  },
  "observability": {
    "enabled": false
  }
}
