{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodadex-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SODADEX_MINING_MOUNT": "disabled",
    "SODADEX_FRAGMENTS_DEPLOYMENT": "{\"chainId\":196,\"pool\":\"0x6366dba62dd679de99078819c212b1fdd431a953\",\"vault\":\"0xb97d23f0c874fc1380016fa31d975d7ccd13b94d\",\"policy\":\"0xb678a4b26ba091d6eeb3aaa85d6abd6afc794937\",\"rewards\":\"0xbBD5ce08aFa04D173982585E0cFC75194eAe3900\",\"locker\":\"0xf9851d7a14ce5cd681aa2e639d8fa0def63bb7fe\",\"fromBlock\":\"73733936\"}"
  },
  "services": [
    {
      "binding": "ORDERS_API",
      "service": "sodadex-orders-test"
    },
    {
      "binding": "MINING_API",
      "service": "sodadex-mining-api-test-1952"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAIN_INDEX",
        "class_name": "SodaChainIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chain-index-sqlite",
      "new_sqlite_classes": [
        "SodaChainIndex"
      ]
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "alias": {
    "viem": "./node_modules/viem/_esm/index.js"
  }
}
