{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodadex-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "soda.ignix.bot",
      "custom_domain": true,
      "zone_name": "ignix.bot"
    }
  ],
  "vars": {
    "SODADEX_FRAGMENTS_DEPLOYMENT": "{\"chainId\":196,\"pool\":\"0x5d98189f79234d5f988ea5b94641c3b04b0a7866\",\"vault\":\"0xb97d23f0c874fc1380016fa31d975d7ccd13b94d\",\"policy\":\"0xb678a4b26ba091d6eeb3aaa85d6abd6afc794937\",\"rewards\":\"0xd64904EDdF64D92178dfaB9e6d0E926D6b520Ca0\",\"locker\":\"0x000ad39076dc89150c27c6e2bf2fe5bca5899f18\",\"fromBlock\":\"73802117\",\"income\":\"0x2004FE0f7F023c24CB826F157235D5d3418B51c8\",\"ignixTreasury\":\"0x6EFa1Fad18900B929Fe6782fd3eaBeac2563416A\"}"
  },
  "services": [
    {
      "binding": "ORDERS_API",
      "service": "sodadex-orders-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAIN_INDEX",
        "class_name": "SodaChainIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-chain-index-sqlite",
      "new_sqlite_classes": [
        "SodaChainIndex"
      ]
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "alias": {
    "viem": "./node_modules/viem/_esm/index.js"
  }
}
