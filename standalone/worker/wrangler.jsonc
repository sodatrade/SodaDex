{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodadex-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "SODADEX_MINING_MOUNT": "enabled" },
  "services": [{ "binding": "ORDERS_API", "service": "sodadex-orders-test" }, { "binding": "MINING_API", "service": "sodadex-mining-api-test-1952" }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
