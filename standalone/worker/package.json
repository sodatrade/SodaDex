{
  "name": "@sodadex/test-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings src test",
    "test": "vitest run",
    "deploy:test": "wrangler deploy"
  },
  "devDependencies": {
    "oxlint": "1.73.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "viem": {
      "ws": "8.21.0"
    }
  },
  "dependencies": {
    "viem": "2.49.0"
  }
}
